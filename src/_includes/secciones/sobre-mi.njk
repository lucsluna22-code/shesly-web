{% import "partials/iconos.njk" as ico %}
{% set a = home.sobre_mi %}
{% set posBadge = ["-left-4 md:-left-12 top-10 md:top-20", "-left-6 md:-left-16 bottom-16 md:bottom-28", "-right-4 md:-right-12 bottom-6 md:bottom-12"] %}
{% set animBadge = ["float 5s infinite ease-in-out", "float 6s infinite ease-in-out reverse", "float 7s infinite ease-in-out"] %}

<section id="about" class="relative pt-12 pb-4 md:pt-16 md:pb-6 lg:pt-24 lg:pb-8 overflow-hidden bg-page">
  <div class="absolute top-0 -left-20 w-96 h-96 bg-white/40 rounded-full blur-[120px] animate-pulse"></div>
  <div class="absolute bottom-0 -right-20 w-[500px] h-[500px] bg-brand/10 rounded-full blur-[140px] animate-pulse [animation-delay:2s]"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">


    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-32">

      <div class="flex-1 relative w-full max-w-[450px] lg:max-w-none">
        <div class="relative z-10 rounded-[3rem] md:rounded-[4.5rem] overflow-hidden border-[12px] md:border-[18px] border-white shadow-[0_50px_100px_-20px_rgba(186,230,253,0.4)] aspect-[4/5] bg-stone-100">
          <img src="{{ a.imagen }}" alt="{{ a.imagen_alt }}" width="768" height="1024" loading="lazy" decoding="async" class="w-full h-full object-cover grayscale-[10%]">
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none"></div>
        </div>

        {% for b in a.insignias %}
        <div class="absolute {{ posBadge[loop.index0] or posBadge[2] }} z-20 glass-card p-4 md:p-6 rounded-[1.5rem] md:rounded-[2.5rem] border-white/80 shadow-2xl" style="animation: {{ animBadge[loop.index0] or animBadge[2] }};">
          <div class="flex flex-col items-center text-center gap-2 md:gap-3">
            <div class="w-10 h-10 md:w-14 md:h-14 bg-{{ b.color }}-100 rounded-2xl flex items-center justify-center">
              <span class="text-2xl md:text-4xl filter drop-shadow-md">{{ b.icono }}</span>
            </div>
            <div class="space-y-0.5">
              <h4 class="font-black text-stone-900 text-[8px] md:text-[10px] uppercase tracking-widest leading-none">{{ b.titulo }}</h4>
              <p class="text-[6px] md:text-[8px] font-bold text-brand-dark uppercase tracking-widest hidden md:block">{{ b.subtitulo }}</p>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="flex-1 space-y-10">
        <header class="space-y-4 md:space-y-6">
          <span class="inline-block text-[10px] md:text-xs font-black uppercase tracking-[0.5em] text-brand-light">{{ a.etiqueta }}</span>
          <h2 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] font-serif text-stone-900 leading-[0.95] tracking-tight">{{ a.titulo_linea1 }} <br><span class="text-gradient italic">{{ a.titulo_destacado }}</span> {{ a.titulo_linea2 }} <br>{{ a.titulo_linea3 }}</h2>
        </header>
        <div class="space-y-8">
          <p class="text-xl md:text-2xl italic font-serif text-stone-400 leading-relaxed max-w-xl">{{ a.frase }}</p>
          <div class="space-y-6 text-base md:text-lg text-stone-600 font-light leading-relaxed max-w-xl">
            {% for p in a.parrafos %}<p>{{ p }}</p>{% endfor %}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
