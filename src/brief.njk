</main>

<script>
(function(){
  var form = document.getElementById('brief');
  var KEY  = 'brief-shesly-v1';
  var campos = form.querySelectorAll('input:not([type=hidden]):not([name="dejar-vacio"]), textarea, select');

  /* ── Restaurar lo guardado ── */
  try{
    var guardado = JSON.parse(localStorage.getItem(KEY) || '{}');
    campos.forEach(function(c){
      if(!(c.name in guardado)) return;
      if(c.type === 'radio'){ if(c.value === guardado[c.name]) c.checked = true; }
      else c.value = guardado[c.name];
    });
    if(Object.keys(guardado).length){
      document.getElementById('saved').innerHTML = '<b>Recuperamos lo que habías escrito.</b> Seguí desde donde quedaste.';
    }
  }catch(e){}

  /* ── Guardar y medir avance ── */
  function guardar(){
    var datos = {};
    campos.forEach(function(c){
      if(c.type === 'radio'){ if(c.checked) datos[c.name] = c.value; }
      else if(c.value.trim()) datos[c.name] = c.value;
    });
    try{ localStorage.setItem(KEY, JSON.stringify(datos)); }catch(e){}
    return datos;
  }

  var nombres = [];
  campos.forEach(function(c){ if(nombres.indexOf(c.name) === -1) nombres.push(c.name); });

  function avance(datos){
    var hechos = nombres.filter(function(n){ return datos[n] && String(datos[n]).trim(); }).length;
    var pct = Math.round(hechos / nombres.length * 100);
    document.getElementById('track').style.width = pct + '%';
    document.getElementById('pct').textContent = pct + '%';
  }

  var t;
  form.addEventListener('input', function(){
    clearTimeout(t);
    t = setTimeout(function(){ avance(guardar()); }, 250);
  });
  form.addEventListener('change', function(){ avance(guardar()); });
  avance(guardar());

  /* ── Limpiar al enviar ── */
  form.addEventListener('submit', function(){
    try{ localStorage.removeItem(KEY); }catch(e){}
  });

  /* ── Copiar el mensaje de testimonios ── */
  var btn = document.getElementById('copy');
  btn.addEventListener('click', function(){
    var texto = document.getElementById('msg').textContent;
    var ok = function(){ btn.textContent = '¡Copiado!'; setTimeout(function(){ btn.textContent = 'Copiar mensaje'; }, 2000); };
    if(navigator.clipboard){ navigator.clipboard.writeText(texto).then(ok, ok); }
    else{
      var a = document.createElement('textarea');
      a.value = texto; document.body.appendChild(a); a.select();
      try{ document.execCommand('copy'); }catch(e){}
      document.body.removeChild(a); ok();
    }
  });
})();
</script>
</body>
</html>
