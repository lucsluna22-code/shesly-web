---
layout: layouts/base.njk
pagination:
  data: collections.formaciones
  size: 1
  alias: f
permalink: "/formaciones/{{ f.data.slug }}/"
eleventyComputed:
  tituloPagina: "{{ f.data.titulo_largo or f.data.titulo }} | {{ site.nombre }}"
  descripcionPagina: "{{ f.data.descripcion_corta }}"
  imagenPagina: "{{ f.data.imagenes[0] or site.seo.og_imagen }}"
---
{% import "partials/iconos.njk" as ico %}
{% import "partials/opciones-compra.njk" as compra %}
{% set d = f.data %}
{# Las dos opciones de compra: propias de la formación si las tiene, si no las del inicio. #}
{% set ops = d.opciones or home.cierre.opciones %}
{% set titulo = d.titulo_largo or d.titulo %}
{% set palabras = titulo.split(" ") %}
{% set wa = "https://wa.me/" + site.contacto.whatsapp + "?text=" + (d.mensaje_whatsapp | urlencode) %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "{{ titulo }}",
  "description": "{{ d.descripcion_corta }}",
  "provider": { "@type": "Person", "name": "{{ site.nombre }}", "url": "{{ site.url }}" },
  "url": "{{ site.url }}/formaciones/{{ d.slug }}/"
}
</script>

<div class="min-h-screen bg-white pt-24 pb-20">
  <div class="container mx-auto px-6 md:px-12 max-w-4xl">

    <a href="/" class="group mb-12 inline-flex items-center gap-4 text-[10px] font-black uppercase tracking-[0.4em] text-stone-400 hover:text-stone-900 transition-colors">
      {{ ico.flecha(16, "group-hover:-translate-x-2 transition-transform") }} Volver al inicio
    </a>

    <div class="space-y-10">

      <div class="space-y-4">
        <div class="text-6xl md:text-8xl mb-6">{{ d.icono }}</div>
        {% if d.evento.etiqueta and not d.evento.proximamente %}
        <span class="inline-block px-4 py-1.5 bg-stone-900 text-white text-[8px] font-black uppercase tracking-[0.3em] rounded-full">{{ d.evento.etiqueta }}</span>
        {% endif %}
        <h1 class="text-5xl md:text-8xl font-serif text-stone-900 leading-none pt-2">
          {%- for p in palabras -%}
            <span class="{% if loop.last %}text-gradient italic{% endif %}">{{ p }} </span>
          {%- endfor -%}
        </h1>
        <p class="text-xl md:text-2xl font-light text-stone-400 italic">{{ d.subtitulo }}</p>
      </div>

      <p class="text-lg md:text-2xl text-stone-600 leading-relaxed font-light">{{ d.descripcion_larga }}</p>

      {# Los datos de un vistazo: lo que antes vivía en la tarjeta del costado. #}
      <div class="pt-8 grid grid-cols-1 sm:grid-cols-3 gap-8 border-t border-stone-100">
        {% if d.evento.fecha %}
        <div class="space-y-2">
          <span class="text-[10px] font-black uppercase tracking-widest text-accent">Cuándo empieza</span>
          <p class="font-serif text-xl text-stone-800 leading-snug">{{ d.evento.fecha }}</p>
        </div>
        {% endif %}
        <div class="space-y-2">
          <span class="text-[10px] font-black uppercase tracking-widest text-accent">Modalidad</span>
          <p class="font-serif text-xl text-stone-800 leading-snug">{{ d.modalidad or ("Online" if d.evento.online else "Presencial") }}</p>
        </div>
        <div class="space-y-2">
          <span class="text-[10px] font-black uppercase tracking-widest text-accent">Duración</span>
          <p class="font-serif text-xl text-stone-800 leading-snug">{{ d.duracion }}</p>
        </div>
        {% if d.evento.ubicacion %}
        <div class="space-y-2">
          <span class="text-[10px] font-black uppercase tracking-widest text-accent">Dónde</span>
          <p class="font-serif text-xl text-stone-800 leading-snug">{{ d.evento.ubicacion }}</p>
        </div>
        {% endif %}
      </div>

      {% if d.temario and d.temario.length %}
      <div class="pt-12 space-y-8">
        <div class="flex items-center gap-6">
          <div class="h-[1px] flex-1 bg-stone-100"></div>
          <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-stone-400 text-center">Temario de la formación</h2>
          <div class="h-[1px] flex-1 bg-stone-100"></div>
        </div>
        <div class="grid md:grid-cols-2 gap-x-12 gap-y-4">
          {% for t in d.temario %}
          <div class="flex items-start gap-4 group">
            <span class="font-mono text-xs text-brand-light mt-1">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
            <p class="text-stone-700 font-light group-hover:text-stone-900 transition-colors">{{ t }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if d.imagenes and d.imagenes.length %}
      <div class="pt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {% for img in d.imagenes %}
        <div class="group relative aspect-[4/5] overflow-hidden rounded-[2.5rem] shadow-lg border-[6px] border-white transition-all hover:scale-[1.02] hover:shadow-2xl">
          <img src="{{ img }}" alt="Ilustración {{ titulo }} {{ loop.index }}" loading="lazy" decoding="async" class="w-full h-full object-cover object-top">
          <div class="absolute inset-0 bg-gradient-to-t from-stone-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if d.evento.descripcion %}
      <div class="pt-12">
        <div class="glass-card rounded-[2.5rem] md:rounded-[3rem] border-white/80 shadow-lg p-8 md:p-11">
          <span class="text-[10px] font-black uppercase tracking-[0.4em] text-accent">Qué incluye</span>
          <p class="mt-5 text-base md:text-lg text-stone-600 font-light leading-relaxed">{{ d.evento.descripcion }}</p>
          <a href="{{ wa }}" target="_blank" rel="noopener noreferrer" data-formacion="{{ d.slug }}"
             class="mt-7 inline-flex items-center gap-2.5 text-[10px] font-black uppercase tracking-[0.25em] text-stone-400 hover:text-stone-900 transition-colors">
            {{ ico.whatsapp(14, "w-3.5 h-3.5 flex-shrink-0") }} Preguntar antes por WhatsApp
          </a>
        </div>
      </div>
      {% endif %}

    </div>

    {% if d.evento.proximamente %}
    <div class="pt-16 md:pt-24 text-center space-y-6 max-w-lg mx-auto">
      <div class="w-20 h-20 bg-rose-100 rounded-full flex items-center justify-center mx-auto"><span class="text-4xl">✨</span></div>
      <h2 class="text-3xl font-serif text-stone-900 leading-tight">Próximamente</h2>
      <p class="text-stone-600 font-light leading-relaxed">Estamos preparando una experiencia transformadora para ti. Muy pronto abriremos nuevas fechas.</p>
      {% if site.redes.instagram %}
      <a href="{{ site.redes.instagram }}" target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-stone-900 text-white text-[10px] font-black uppercase tracking-[0.25em] hover:bg-brand-dark transition-colors">
        {{ ico.instagram(16, "w-4 h-4") }} Seguir para enterarme
      </a>
      {% endif %}
    </div>

    {% elif ops and ops.length %}
    {{ compra.opcionesCompra(ops, wa, "Elige cómo empezar", home.cierre.bajada, home.cierre.nota) }}
    {% if d.evento.nota_final %}
    <p class="mt-8 text-center text-[9px] text-stone-400 font-medium tracking-widest uppercase">{{ d.evento.nota_final }}</p>
    {% endif %}

    {% else %}
    <div class="pt-16 md:pt-24 max-w-md mx-auto">
      <a href="{{ wa }}" target="_blank" rel="noopener noreferrer" data-evento="reservar" data-formacion="{{ d.slug }}"
         class="w-full py-5 bg-[#25D366] text-white rounded-[2rem] font-bold uppercase tracking-[0.25em] text-[10px] hover:bg-[#1ebe5d] transition-all transform hover:-translate-y-1 shadow-xl shadow-green-200/50 active:scale-95 flex items-center justify-center gap-3">
        {{ ico.whatsapp(20, "w-5 h-5 flex-shrink-0") }} {{ d.evento.etiqueta_boton }}
      </a>
    </div>
    {% endif %}

  </div>
</div>
