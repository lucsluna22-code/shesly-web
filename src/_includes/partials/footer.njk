{% import "partials/iconos.njk" as ico %}
{% set wa = "https://wa.me/" + site.contacto.whatsapp + "?text=" + (site.extras.mensaje_whatsapp_general | urlencode) %}

<footer id="contact" class="bg-stone-50 pt-20 md:pt-24 pb-12 border-t border-stone-200">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="grid md:grid-cols-4 gap-12 mb-16">

      <div class="col-span-full md:col-span-2 space-y-6 text-center md:text-left">
        <h2 class="text-3xl font-serif tracking-widest">{{ site.logo_linea1 }} <span class="text-brand-light">{{ site.logo_linea2 | upper }}</span></h2>
        <p class="text-stone-500 max-w-sm mx-auto md:mx-0">{{ site.pie.descripcion }}</p>
        <div class="flex justify-center md:justify-start gap-4">
          {% if site.redes.instagram %}
          <a href="{{ site.redes.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center hover:bg-brand hover:text-white transition-all">{{ ico.instagram(16, "") }}</a>
          {% endif %}
          {% if site.redes.facebook %}
          <a href="{{ site.redes.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center hover:bg-brand hover:text-white transition-all">{{ ico.facebook(16, "") }}</a>
          {% endif %}
          {% if site.redes.youtube %}
          <a href="{{ site.redes.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center hover:bg-brand hover:text-white transition-all">{{ ico.youtube(16, "") }}</a>
          {% endif %}
          {% if site.redes.tiktok %}
          <a href="{{ site.redes.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center hover:bg-brand hover:text-white transition-all">{{ ico.tiktok(16, "") }}</a>
          {% endif %}
          <a href="{{ wa }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="w-10 h-10 bg-white border border-stone-200 rounded-full flex items-center justify-center hover:bg-green-500 hover:text-white transition-all">{{ ico.whatsapp(16, "") }}</a>
        </div>
      </div>

      <div class="text-center md:text-left">
        <h4 class="font-bold text-[10px] uppercase tracking-widest mb-6">Enlaces</h4>
        <ul class="space-y-4 text-stone-500 text-sm">
          {% for item in site.navegacion %}
          <li><a href="{{ item.url }}" class="hover:text-brand transition-colors">{{ item.texto }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="text-center md:text-left">
        <h4 class="font-bold text-[10px] uppercase tracking-widest mb-6">Contacto</h4>
        <ul class="space-y-4 text-stone-500 text-sm">
          <li><a href="mailto:{{ site.contacto.email }}" class="hover:text-brand transition-colors">{{ site.contacto.email }}</a></li>
          <li>
            <a href="{{ wa }}" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors flex items-center justify-center md:justify-start gap-2">
              {{ ico.whatsapp(14, "text-brand-light") }}{{ site.contacto.telefono_texto }}
            </a>
          </li>
          <li>{{ site.contacto.ubicacion }}</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-stone-200 pt-8 flex flex-col md:grid md:grid-cols-3 items-center gap-6 text-[8px] md:text-[10px] text-stone-400 font-medium tracking-[0.2em] uppercase text-center">
      <div class="md:order-1 md:text-left"><p>{{ site.pie.copyright }}</p></div>
      <div class="md:order-3 flex justify-center md:justify-end gap-8">
        {% for l in site.pie.legales %}<a href="{{ l.url }}" class="hover:text-stone-600">{{ l.texto }}</a>{% endfor %}
      </div>
      <div class="md:order-2 order-last md:text-center">
        <p>{{ site.pie.credito_texto }} {% if site.pie.credito_url %}<a href="{{ site.pie.credito_url }}" target="_blank" rel="noopener noreferrer" class="hover:text-brand transition-colors text-stone-400">{{ site.pie.credito_nombre }}</a>{% else %}<span class="text-stone-400">{{ site.pie.credito_nombre }}</span>{% endif %}</p>
      </div>
    </div>
  </div>
</footer>
