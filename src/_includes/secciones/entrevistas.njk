{% set e = home.entrevistas %}
{% if e and e.lista and e.lista.length %}

<section id="entrevistas" class="relative pt-16 pb-16 md:pt-20 md:pb-20 lg:pt-24 lg:pb-28 overflow-hidden bg-page">
  <div class="absolute top-1/3 left-0 w-[460px] h-[460px] bg-white/40 rounded-full blur-[130px]"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">

    <div class="max-w-3xl space-y-5 md:space-y-7 mb-10 md:mb-14">
      <span class="inline-block text-[10px] md:text-xs font-black uppercase tracking-[0.5em] text-brand-light">{{ e.etiqueta }}</span>
      <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif text-stone-900 leading-[1.02] tracking-tight">{{ e.titulo_linea1 }} <span class="text-gradient italic">{{ e.titulo_destacado }}</span></h2>
      {% if e.bajada %}<p class="text-base md:text-xl text-stone-500 font-light leading-relaxed">{{ e.bajada }}</p>{% endif %}
    </div>

    <div class="grid sm:grid-cols-2 gap-6 md:gap-8 max-w-4xl">
      {% for v in e.lista %}
      <a href="{{ v.url }}" target="_blank" rel="noopener noreferrer" data-evento="entrevista"
         class="group block rounded-[1.75rem] md:rounded-[2.25rem] overflow-hidden glass-card border-white/80 shadow-lg transition-transform duration-500 hover:-translate-y-1 reveal-on-scroll"
         style="transition-delay: {{ loop.index0 * 110 }}ms;">
        <div class="relative aspect-video bg-stone-900 overflow-hidden">
          {# La miniatura viene del propio YouTube; si no carga, queda el fondo oscuro con el botón. #}
          <img src="https://i.ytimg.com/vi/{{ v.id }}/hqdefault.jpg" alt="{{ v.titulo }}" width="480" height="360" loading="lazy" decoding="async"
               onerror="this.remove()"
               class="w-full h-full object-cover opacity-90 transition-all duration-700 group-hover:opacity-100 group-hover:scale-[1.04]">
          <span class="absolute inset-0 flex items-center justify-center">
            <span class="w-14 h-14 md:w-16 md:h-16 rounded-full bg-white/90 shadow-2xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
              <svg class="w-5 h-5 md:w-6 md:h-6 text-stone-900 translate-x-[2px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </span>
        </div>
        <div class="p-6 md:p-7">
          <span class="text-[10px] font-black uppercase tracking-[0.25em] text-brand-dark">{{ v.detalle }}</span>
          <h3 class="mt-2.5 font-serif text-xl md:text-2xl text-stone-900 leading-tight">{{ v.titulo }}</h3>
          <span class="mt-4 inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.25em] text-stone-400 group-hover:text-stone-900 transition-colors">
            Ver en YouTube
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </span>
        </div>
      </a>
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}
