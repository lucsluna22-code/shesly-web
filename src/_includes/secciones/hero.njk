{% set h = home.hero %}
<section id="hero" class="relative min-h-screen flex items-center justify-center pt-28 pb-12 lg:pt-24 lg:pb-0 overflow-hidden bg-page">

  {% if theme.efectos.animacion_hero %}
  <div class="canvas-container mix-blend-multiply opacity-100" data-hero-canvas></div>
  {% endif %}

  <div class="absolute top-[-10%] left-[-5%] w-[80vw] h-[80vw] bg-white/40 rounded-full blur-[140px] z-0" style="animation: blob 25s infinite linear;"></div>
  <div class="absolute bottom-[-10%] right-[-5%] w-[60vw] h-[60vw] bg-brand/10 rounded-full blur-[120px] z-0" style="animation: blob 30s infinite linear reverse;"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-24">

      <div class="flex-1 text-center lg:text-left space-y-6 md:space-y-12">
        <div class="stagger-up [animation-delay:0.2s]">
          <div class="inline-flex items-center gap-3 px-6 py-2 bg-white/70 backdrop-blur-xl border border-white/90 rounded-full text-[9px] md:text-xs font-black uppercase tracking-[0.4em] text-brand-dark shadow-sm mb-6 md:mb-10">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-light opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"></span>
            </span>{{ h.etiqueta }}
          </div>
          <h1 class="text-[2.6rem] sm:text-6xl md:text-[4.25rem] lg:text-[4.5rem] xl:text-[5.25rem] font-serif leading-[1.05] md:leading-[0.98] pb-[0.14em] text-stone-900 reveal-mask tracking-tight">{{ h.titulo_linea1 }} <br><span class="text-gradient italic">{{ h.titulo_destacado }}</span><br>{{ h.titulo_linea2 }}</h1>
          {% if h.subtitulo %}
          <p class="mt-5 md:mt-7 font-serif italic text-2xl sm:text-3xl md:text-4xl text-stone-500 leading-tight">{{ h.subtitulo }}</p>
          {% endif %}
        </div>

        <p class="stagger-up [animation-delay:0.4s] text-base md:text-2xl text-stone-500 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light">{{ h.bajada }} <span class="font-medium text-stone-900">{{ h.bajada_destacado }}</span>{{ h.bajada_final }}</p>

        <div class="stagger-up [animation-delay:0.6s] flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 md:gap-6 pt-4">
          <a href="{{ h.boton_url }}" class="w-full sm:w-auto text-center px-10 py-5 bg-stone-900 text-white rounded-full font-bold tracking-[0.3em] text-[10px] uppercase shadow-2xl hover:bg-brand-dark transition-all transform hover:-translate-y-1">{{ h.boton_texto }}</a>
          {% if h.boton2_texto %}
          <a href="{{ h.boton2_url }}" class="w-full sm:w-auto text-center px-10 py-5 bg-white/70 backdrop-blur-xl border border-white/90 text-stone-700 rounded-full font-bold tracking-[0.3em] text-[10px] uppercase shadow-sm hover:bg-white hover:text-brand-dark transition-all transform hover:-translate-y-1">{{ h.boton2_texto }}</a>
          {% endif %}
        </div>
      </div>

      <div class="flex-1 relative stagger-up [animation-delay:0.5s] w-full max-w-[320px] sm:max-w-[400px] lg:max-w-[500px] mt-12 lg:mt-0">
        <div class="relative z-10 w-full aspect-[4/5] overflow-hidden shadow-[0_40px_80px_-20px_rgba(186,230,253,0.3)] border-[8px] md:border-[12px] border-white/80 backdrop-blur-md" style="border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; animation: float 6s infinite ease-in-out;">
          <img src="{{ h.imagen }}" alt="{{ h.imagen_alt }}" width="768" height="1024" fetchpriority="high" decoding="async" class="w-full h-full object-cover grayscale-[10%]">
        </div>
        <div class="absolute -bottom-4 -right-4 sm:-bottom-8 sm:-right-8 glass-card p-6 md:p-10 rounded-[2.5rem] max-w-[160px] md:max-w-[280px] z-20 border-white/90 shadow-2xl">
          <div class="flex items-center gap-3 mb-3 md:mb-5">
            <div class="h-[1px] w-8 bg-brand/40"></div>
            <span class="text-[7px] md:text-[9px] font-black tracking-widest uppercase text-brand-dark">{{ h.tarjeta_etiqueta }}</span>
          </div>
          <p class="text-sm md:text-2xl italic font-serif leading-tight text-stone-800">{{ h.tarjeta_frase }}</p>
        </div>
      </div>

    </div>
  </div>
</section>
