{% set c = home.contacto %}
<section id="contacto" class="relative py-20 md:py-32 overflow-hidden bg-page">
  <div class="absolute top-1/4 right-0 w-[500px] h-[500px] bg-white/50 rounded-full blur-[130px] -z-10"></div>

  <div class="max-w-3xl mx-auto px-6 md:px-12 relative z-10 text-center">
    <span class="inline-block text-[10px] md:text-xs font-black uppercase tracking-[0.5em] text-brand-light mb-6">{{ c.etiqueta }}</span>
    <h2 class="text-5xl md:text-7xl font-serif text-stone-900 leading-[1.05] mb-6">{{ c.titulo }} <span class="text-gradient italic">{{ c.titulo_destacado }}</span></h2>
    <p class="text-lg md:text-xl text-stone-500 font-light mb-14 max-w-xl mx-auto">{{ c.bajada }}</p>

    <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/gracias/"
          class="glass-card rounded-[2.5rem] md:rounded-[3.5rem] p-8 md:p-12 text-left space-y-6 shadow-2xl">
      <input type="hidden" name="form-name" value="contacto">
      <p class="hidden"><label>No llenar: <input name="bot-field"></label></p>

      <div class="grid sm:grid-cols-2 gap-6">
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-stone-500">Nombre</span>
          <input type="text" name="nombre" required autocomplete="name"
                 class="mt-2 w-full rounded-2xl border border-white/80 bg-white/70 px-5 py-4 text-stone-800 placeholder-stone-300 outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 transition"
                 placeholder="Tu nombre">
        </label>
        <label class="block">
          <span class="text-[10px] font-black uppercase tracking-[0.3em] text-stone-500">Email</span>
          <input type="email" name="email" required autocomplete="email"
                 class="mt-2 w-full rounded-2xl border border-white/80 bg-white/70 px-5 py-4 text-stone-800 placeholder-stone-300 outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 transition"
                 placeholder="tu@email.com">
        </label>
      </div>

      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-stone-500">Me interesa</span>
        <select name="interes" class="mt-2 w-full rounded-2xl border border-white/80 bg-white/70 px-5 py-4 text-stone-800 outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 transition">
          <option>Información general</option>
          {% for item in collections.formaciones %}{% if item.data.visible %}<option>{{ item.data.titulo }}</option>{% endif %}{% endfor %}
        </select>
      </label>

      <label class="block">
        <span class="text-[10px] font-black uppercase tracking-[0.3em] text-stone-500">Mensaje</span>
        <textarea name="mensaje" rows="5" required
                  class="mt-2 w-full rounded-2xl border border-white/80 bg-white/70 px-5 py-4 text-stone-800 placeholder-stone-300 outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 transition"
                  placeholder="Contame en qué momento estás…"></textarea>
      </label>

      <button type="submit" class="w-full py-5 bg-stone-900 text-white rounded-[2rem] font-bold uppercase tracking-[0.3em] text-[10px] hover:bg-brand-dark transition-all transform hover:-translate-y-1 active:scale-95 shadow-xl">{{ c.boton }}</button>
    </form>
  </div>
</section>
