{% set b = home.banner %}
{% if b and b.imagen %}
<section id="banner" class="relative pt-4 pb-16 md:pt-6 md:pb-20 lg:pb-24 overflow-hidden bg-page">
  <div class="absolute top-1/4 right-0 w-[520px] h-[520px] bg-brand/10 rounded-full blur-[140px]"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <a href="{{ b.url }}" class="group block rounded-[2.5rem] md:rounded-[3.5rem] overflow-hidden bg-stone-900 shadow-2xl transition-transform duration-500 hover:-translate-y-1 reveal-on-scroll">
      <div class="flex flex-col md:flex-row items-stretch">
        <div class="w-full md:w-[340px] lg:w-[400px] shrink-0 md:self-start aspect-[3/4] overflow-hidden">
          <img src="{{ b.imagen }}" alt="{{ b.imagen_alt }}" width="1086" height="1448" loading="lazy" decoding="async"
               class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]">
        </div>
        <div class="flex-1 p-9 sm:p-12 md:p-14 lg:p-16 flex flex-col justify-center text-white">
          {% if b.etiqueta %}
          <span class="text-[10px] md:text-xs font-black uppercase tracking-[0.4em] text-brand-light mb-5">{{ b.etiqueta }}</span>
          {% endif %}
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-[1.05]">{{ b.titulo }}</h2>
          <p class="mt-6 text-base md:text-lg text-white/70 font-light leading-relaxed max-w-md">{{ b.texto }}</p>
          <span class="mt-9 inline-flex items-center gap-4 self-start px-8 py-4 rounded-full bg-white text-stone-900 font-bold tracking-[0.2em] text-[10px] uppercase group-hover:bg-brand group-hover:text-white transition-colors">
            {{ b.boton }}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
{% endif %}
