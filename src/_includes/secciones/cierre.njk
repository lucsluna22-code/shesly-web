{% set c = home.cierre %}
{% set wa = "https://wa.me/" + site.contacto.whatsapp + "?text=" + (site.extras.mensaje_whatsapp_general | urlencode) %}

<section id="reservar" class="relative pt-16 pb-20 md:pt-20 md:pb-24 lg:pt-24 lg:pb-32 overflow-hidden bg-page">
  <div class="absolute top-0 right-0 w-[520px] h-[520px] bg-brand/10 rounded-full blur-[140px]"></div>
  <div class="absolute bottom-0 left-0 w-[420px] h-[420px] bg-white/50 rounded-full blur-[130px]"></div>

  <div class="max-w-6xl mx-auto px-6 md:px-12 relative z-10">

    <div class="max-w-2xl mx-auto text-center space-y-5 md:space-y-7 mb-12 md:mb-16">
      <span class="inline-block text-[10px] md:text-xs font-black uppercase tracking-[0.5em] text-brand-light">{{ c.etiqueta }}</span>
      <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-serif text-stone-900 leading-[1.02] tracking-tight">{{ c.titulo_linea1 }} <span class="text-gradient italic">{{ c.titulo_destacado }}</span></h2>
      <p class="text-base md:text-xl text-stone-500 font-light leading-relaxed">{{ c.bajada }}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8 max-w-4xl mx-auto">
      {% for o in c.opciones %}
      <div class="relative rounded-[2.5rem] md:rounded-[3rem] p-8 md:p-12 flex flex-col shadow-xl reveal-on-scroll
                  {% if o.destacado %}bg-stone-900 text-white border border-stone-800{% else %}glass-card border-white/80{% endif %}"
           style="transition-delay: {{ loop.index0 * 120 }}ms;">
        {% if o.destacado %}
        <span class="absolute -top-3 left-8 md:left-12 px-4 py-1.5 rounded-full bg-brand text-white text-[9px] font-black uppercase tracking-[0.3em] shadow-lg">Más elegido</span>
        {% endif %}
        <h3 class="font-serif text-2xl md:text-3xl leading-tight {% if o.destacado %}text-white{% else %}text-stone-900{% endif %}">{{ o.titulo }}</h3>
        <p class="mt-5 font-serif text-4xl md:text-5xl {% if o.destacado %}text-white{% else %}text-stone-900{% endif %}">{{ o.precio }}</p>
        {% if o.precio_nota %}<p class="mt-2 text-xs {% if o.destacado %}text-white/50{% else %}text-stone-400{% endif %}">{{ o.precio_nota }}</p>{% endif %}
        <p class="mt-4 text-sm md:text-base font-light leading-relaxed mb-9 flex-1 {% if o.destacado %}text-white/70{% else %}text-stone-500{% endif %}">{{ o.detalle }}</p>
        <a href="{{ o.url or wa }}" {% if o.url %}target="_blank" rel="noopener"{% endif %}
           class="block text-center px-8 py-5 rounded-full font-bold tracking-[0.2em] text-[10px] uppercase transition-all transform hover:-translate-y-1 shadow-2xl
                  {% if o.destacado %}bg-white text-stone-900 hover:bg-brand hover:text-white{% else %}bg-stone-900 text-white hover:bg-brand-dark{% endif %}">{{ o.boton }}</a>
      </div>
      {% endfor %}
    </div>

    {% if c.nota %}
    <p class="mt-10 md:mt-14 text-center text-xs md:text-sm text-stone-400 font-light max-w-xl mx-auto">
      {{ c.nota }}
      <a href="{{ wa }}" class="underline decoration-brand/40 hover:text-brand-dark">WhatsApp</a>.
    </p>
    {% endif %}

  </div>
</section>
