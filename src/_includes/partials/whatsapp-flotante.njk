{% import "partials/iconos.njk" as ico %}
<a href="https://wa.me/{{ site.contacto.whatsapp }}?text={{ site.extras.mensaje_whatsapp_general | urlencode }}"
   target="_blank" rel="noopener noreferrer"
   aria-label="Escribir por WhatsApp"
   class="fixed bottom-6 right-6 z-[110] w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-2xl shadow-green-500/30 hover:scale-110 hover:bg-[#1ebe5d] active:scale-95 transition-all">
  {{ ico.whatsapp(28, "w-7 h-7 md:w-8 md:h-8") }}
  <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-20 pointer-events-none"></span>
</a>
